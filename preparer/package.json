{
  "name": "usb-ai-preparer",
  "version": "0.1.0",
  "private": true,
  "main": "main.mjs",
  "type": "module",
  "build": {
    "appId": "ch.fabriziocasula.usbai.preparer",
    "productName": "Prepara USB AI",
    "electronVersion": "40.0.0",
    "asar": true,
    "files": ["main.mjs", "copy.mjs", "index.html", "preload.cjs"],
    "extraResources": [{ "from": "payload", "to": "payload" }],
    "directories": { "output": "../release/preparer" },
    "win": { "target": ["portable"] },
    "mac": { "target": ["zip"], "category": "public.app-category.utilities" }
  }
}
